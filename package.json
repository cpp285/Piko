{
  "name": "piko-root",
  "private": true,
  "version": "0.1.101",
  "scripts": {
    "dev": "pnpm --filter piko dev & pnpm --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "dev:gateway": "pnpm --filter piko dev",
    "start": "pnpm --filter web build && pnpm --filter piko start",
    "build": "pnpm -r build",
    "build:release": "pnpm --filter web build && pnpm --filter piko build",
    "publish:release": "pnpm run build:release && cd apps/gateway && npm publish",
    "lint": "pnpm -r lint",
    "dev:desktop": "pnpm --filter piko-desktop dev",
    "build:desktop": "pnpm --filter piko-desktop build",
    "test": "pnpm --filter @piko/memory test && pnpm --filter piko test",
    "typecheck": "pnpm --filter @piko/shared typecheck && pnpm --filter @piko/memory typecheck && pnpm --filter @piko/orchestrator typecheck && pnpm --filter piko typecheck && pnpm --filter web exec tsc --noEmit",
    "review": "node scripts/review.mjs",
    "test:scene": "pnpm --filter piko exec tsx ../../scripts/scenes/verify-scenes.ts",
    "test:characters": "pnpm --filter piko exec tsx ../../scripts/characters/verify-characters.ts",
    "build:scene": "node scripts/scenes/build-scenes.mjs",
    "test:chat": "pnpm --filter piko exec tsx --test ../web/src/components/office/ui/__tests__/conversation-model.test.ts ../web/src/components/office/ui/__tests__/active-tasks.test.ts ../web/src/components/office/ui/__tests__/chat-markdown.test.ts ../web/src/components/office/ui/__tests__/document-preview.test.ts",
    "install:desktop": "bash scripts/install-desktop.sh",
    "check:public": "node scripts/check-public-files.mjs",
    "test:public": "node --test scripts/check-public-files.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
