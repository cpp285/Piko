{
  "name": "piko",
  "version": "1.2.5",
  "description": "Piko personal agent and office agent workspace — AI coworkers, group chats, skills and task collaboration",
  "type": "module",
  "bin": {
    "piko": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "NODE_ENV=development WS_PORT=9099 tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsup && rm -rf dist/web && cp -r ../web/out dist/web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/__tests__/*.test.ts"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.74.0",
    "ably": "^2.6.0",
    "dotenv": "^16.4.0",
    "nanoid": "^5.0.0",
    "node-telegram-bot-api": "^0.67.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@piko/orchestrator": "workspace:*",
    "@piko/shared": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/node-telegram-bot-api": "^0.64.13",
    "@types/ws": "^8.5.0",
    "tsup": "^8.5.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "ai",
    "agent",
    "personal-agent",
    "office-agent",
    "work-agent",
    "ai-assistant",
    "multi-agent",
    "agent-workspace",
    "gateway"
  ],
  "license": "MIT"
}
