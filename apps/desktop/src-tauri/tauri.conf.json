{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Piko",
  "version": "0.1.101",
  "identifier": "com.crewloom.desktop",
  "build": {
    "frontendDist": "../../web/out",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bash scripts/build-desktop.sh",
    "beforeDevCommand": "pnpm --filter piko dev & pnpm --filter web dev"
  },
  "app": {
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob:; img-src 'self' data: blob: http://localhost:* http://127.0.0.1:*; connect-src 'self' ws://localhost:* ws://127.0.0.1:* http://localhost:* http://127.0.0.1:*; frame-src http://localhost:* http://127.0.0.1:*; media-src 'self' data: blob:"
    },
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Piko",
        "width": 1280,
        "height": 860,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "url": "pair",
        "label": "main",
        "minWidth": 860,
        "minHeight": 600,
        "center": true,
        "backgroundColor": "#f7f8f5",
        "titleBarStyle": "Visible"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "sidecar/node": "sidecar/node",
      "sidecar/gateway.js": "sidecar/gateway.js",
      "sidecar/web/": "sidecar/web/",
      "sidecar/agents/": "agents/"
    },
    "macOS": {
      "minimumSystemVersion": "13.5",
      "signingIdentity": "-"
    },
    "category": "Productivity",
    "shortDescription": "AI 团队协作工作室"
  },
  "plugins": {}
}
